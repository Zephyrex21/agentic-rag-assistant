# ⚠️ IF YOU ALREADY HAVE A .env FILE FROM BEFORE: this project has hit two
# rounds of Gemini model deprecation issues (Google cutting off models early).
# Your EXISTING .env won't auto-update just because this file changed - open
# your real .env and make sure GENERATION_MODEL / UTILITY_MODEL / their
# _FALLBACK values match what's below, or delete those lines entirely so the
# code's built-in defaults apply.

# Server
PORT=5000

# --- Gemini API keys ---
# Free tier, get keys at https://aistudio.google.com/apikey
# NOTE: this is NOT your Gemini Pro app subscription - it's a separate free developer key
#
# You can use ONE key for everything (set only GEMINI_API_KEY below), or
# distribute load across up to 3 separate keys/projects - recommended if
# you're hitting free-tier rate limits, since embeddings are called far more
# often than generation, and the new rewrite/rerank calls (Phase 6) can run
# on their own key so they never compete with your main answer quality.
GEMINI_API_KEY=your-shared-fallback-key-here
GEMINI_API_KEY_EMBEDDING=
GEMINI_API_KEY_GENERATION=
GEMINI_API_KEY_UTILITY=

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# No automatic fallback for this one (unlike generation/utility) - a
# different embedding model could produce different vector dimensions,
# which would corrupt your Pinecone index rather than gracefully degrade.
# If this model ever gets deprecated, update this value AND recreate your
# Pinecone index if the replacement's dimensions differ from 768.

# Main answer generation model. gemini-3.5-flash is the current stable
# default (free tier, no shutdown date announced as of this writing).
# GENERATION_MODEL_FALLBACK is tried automatically if the primary model
# ever gets deprecated/shut down. The fallback deliberately points at a
# DIFFERENT model family (not another 2.5-line model) - gemini-2.5-flash
# AND gemini-2.5-flash-lite were both affected by the same Google cutoff,
# so neither is safe as a fallback default anymore.
GENERATION_MODEL=gemini-3.5-flash
GENERATION_MODEL_FALLBACK=gemini-3.1-flash-lite

# Query rewriting + reranking (Phase 6) deliberately use a lighter/cheaper
# model - these are mechanical judgment tasks, not the main answer.
# Cross-paired with the generation model above (reverse pairing) - two
# independent stable models covering each other, same reasoning as above.
UTILITY_MODEL=gemini-3.1-flash-lite
UTILITY_MODEL_FALLBACK=gemini-3.5-flash

# Pinecone (vector storage) - free tier, get key at https://app.pinecone.io
# IMPORTANT: when creating your index, set Dimensions = 768 to match EMBEDDING_DIMENSIONS above
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=rag-assistant

# Supabase (documents + conversations + messages + chunks) - free tier
# Project Settings -> API in your Supabase dashboard.
# IMPORTANT: use the service_role key here, NOT the anon/public key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Chunking config
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=50

# --- Retrieval config ---
RETRIEVAL_TOP_K=5
# How many candidates to pull from EACH retrieval method (vector + keyword)
# before fusion/reranking narrows it down to RETRIEVAL_TOP_K.
RETRIEVAL_CANDIDATE_POOL=15
# Used only as a fallback threshold when ENABLE_RERANKING=false.
MIN_RELEVANCE_SCORE=0.35
# Safety net for when reranking rejects EVERY candidate - rescues with
# unranked top-K if retrieval itself found at least this much signal,
# instead of a false "not enough info" from one overly strict rerank
# judgment (this is what fixed broad questions like "what is this about?"
# sometimes getting rejected wholesale). Deliberately lower/more lenient
# than MIN_RELEVANCE_SCORE - it only guards this one specific failure mode.
RERANK_RESCUE_THRESHOLD=0.15

# --- Phase 6 pipeline toggles ---
# Every stage can be turned off independently without touching code -
# useful for comparing answer quality with/without each one, or dialing
# back cost/latency if free-tier quota ever gets tight.
ENABLE_QUERY_REWRITE=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
# Self-verification: after an answer streams in, one cheap call checks
# whether it's actually supported by its sources. If not, ONE corrected
# revision streams in as a visible replacement (not a silent retry).
ENABLE_SELF_VERIFICATION=true

# Conversation config - how many recent messages to include as context for follow-ups
CONVERSATION_HISTORY_TURNS=6
