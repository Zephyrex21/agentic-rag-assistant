# ⚠️ IF YOU ALREADY HAVE A .env FILE FROM BEFORE: this project migrated from
# Gemini to Groq (generation) + Jina AI (embeddings) after repeated Gemini
# API key/auth issues. Your EXISTING .env from before this migration will NOT
# work - the GEMINI_* variables are gone, replaced by GROQ_API_KEY and
# JINA_API_KEY below. Update your real .env accordingly.
#
# Note: switching embedding providers means any documents you already
# ingested were embedded in Gemini's vector space, which is NOT compatible
# with Jina's - re-upload your documents after updating .env.

# Server
PORT=5000

# --- Groq API key (generation, query rewriting, reranking, self-verification) ---
# Free tier, no credit card required: https://console.groq.com/keys
#
# Unlike Gemini, Groq's rate limits apply per-ORGANIZATION, not per-key, so
# there's no benefit to multiple keys here - just one shared key for
# everything.
GROQ_API_KEY=your-groq-key-here

# Main answer generation model. llama-3.3-70b-versatile is a current
# production-tier model on Groq's free tier, not on the deprecation list as
# of this writing. GENERATION_MODEL_FALLBACK is tried automatically if the
# primary model ever gets decommissioned - see modelFallback.js. The
# fallback deliberately points at a DIFFERENT model family (OpenAI's
# open-weight line, not another Llama model) so a single vendor-family
# issue can't take out both at once.
GENERATION_MODEL=llama-3.3-70b-versatile
GENERATION_MODEL_FALLBACK=openai/gpt-oss-120b

# Query rewriting + reranking + self-verification deliberately use a
# lighter/cheaper model - these are mechanical judgment tasks, not the main
# answer. Cross-paired with the generation model above (reverse pairing) -
# two independent model families covering each other.
UTILITY_MODEL=llama-3.1-8b-instant
UTILITY_MODEL_FALLBACK=openai/gpt-oss-20b

# --- Mistral AI (optional provider-level fallback for generation) ---
# Free tier, no credit card required, ~1B tokens/month:
# https://console.mistral.ai/api-keys
# No key set = this feature is simply skipped, everything else works
# exactly as before.
#
# This is a DIFFERENT kind of fallback than GENERATION_MODEL_FALLBACK
# above: that one only helps if a specific Groq model gets decommissioned.
# This one helps if Groq itself is down, rate-limited, or unreachable -
# the request retries against Mistral entirely, a completely different
# provider. This exists specifically so a single provider having a bad day
# can't take the whole app down (see project history for why that matters
# here - this used to point at Cerebras, until their free tier terms
# changed with no warning; Mistral was picked as a large, well-funded lab
# less likely to do the same, but nothing free is bulletproof forever -
# this is a one-file swap if it ever needs to change again).
MISTRAL_API_KEY=
MISTRAL_FALLBACK_MODEL=mistral-large-latest

# --- Jina AI API key (embeddings) ---
# Free tier (1M tokens, no credit card required): https://jina.ai/embeddings/
#
# Groq itself does not have a reliable, well-documented embeddings API as of
# this writing (their own RAG guide uses a separate library for embeddings),
# so this project uses Jina specifically for that piece.
JINA_API_KEY=your-jina-key-here

EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=768
# 768 is one of jina-embeddings-v3's officially supported Matryoshka
# checkpoint sizes, chosen to match the existing Pinecone index dimension -
# no index recreation needed if you're migrating from the Gemini version of
# this project (you will still need to re-upload/re-ingest your documents
# though - embeddings from a different model are never comparable to old
# ones, even at the same dimension).
# No automatic fallback for this one (unlike generation/utility) - a
# different embedding model could produce a genuinely different vector
# space, which would corrupt your Pinecone index rather than gracefully
# degrade. If you change this, re-ingest all documents afterward.

# Pinecone (vector storage) - free tier, get key at https://app.pinecone.io
# IMPORTANT: when creating your index, set Dimensions = 768 to match EMBEDDING_DIMENSIONS above
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=rag-assistant

# Supabase (documents + conversations + messages + chunks) - free tier
# Project Settings -> API in your Supabase dashboard.
# IMPORTANT: use the service_role key here, NOT the anon/public key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Chunking config
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=50
# Chunk boundaries snap forward (up to ~40 words) to the nearest sentence
# ending instead of cutting strictly mid-sentence - keeps citations/excerpts
# readable and improves embedding quality. Not configurable via env; see
# snapToSentenceBoundary in chunking.js if you need to tune it.

# --- Retrieval config ---
RETRIEVAL_TOP_K=5
# How many candidates to pull from EACH retrieval method (vector + keyword)
# before fusion/reranking narrows it down to RETRIEVAL_TOP_K.
RETRIEVAL_CANDIDATE_POOL=15
# Used only as a fallback threshold when ENABLE_RERANKING=false.
MIN_RELEVANCE_SCORE=0.35
# Safety net for when reranking rejects EVERY candidate - rescues with
# unranked top-K if retrieval itself found at least this much signal,
# instead of a false "not enough info" from one overly strict rerank
# judgment (this is what fixed broad questions like "what is this about?"
# sometimes getting rejected wholesale). Deliberately lower/more lenient
# than MIN_RELEVANCE_SCORE - it only guards this one specific failure mode.
RERANK_RESCUE_THRESHOLD=0.15

# --- Retrieval quality config ---
# How many alternate phrasings of the query to generate for multi-query
# retrieval (in addition to the original/rewritten query itself). Each one
# runs its own hybrid search in parallel, and all result lists get fused
# together with RRF - catches cases where the user's exact wording doesn't
# match the document's vocabulary. Set to 0 to disable (falls back to
# searching with only the original query, same as before this existed).
QUERY_EXPANSION_COUNT=2

# Drops near-duplicate chunks from the candidate pool before reranking
# (cheap word-overlap check, no extra API calls) - more likely to matter
# now that multi-query retrieval searches the same corpus from several
# angles at once. 0.82 = fairly strict, only merges genuinely near-identical
# text; lower it to dedupe more aggressively.
DEDUP_SIMILARITY_THRESHOLD=0.82

# Broad questions ("summarize this", "compare X and Y", "give me an
# overview") get RETRIEVAL_TOP_K + this many extra chunks, since they
# genuinely need more source material than a narrow factual question does.
# Classified with a cheap keyword heuristic, not an extra LLM call.
ADAPTIVE_TOPK_BONUS=3

# --- Phase 6 pipeline toggles ---
# Every stage can be turned off independently without touching code -
# useful for comparing answer quality with/without each one, or dialing
# back cost/latency if free-tier quota ever gets tight.
ENABLE_QUERY_REWRITE=true
ENABLE_QUERY_EXPANSION=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
ENABLE_DEDUPLICATION=true
ENABLE_ADAPTIVE_TOPK=true
# Self-verification: after an answer streams in, one cheap call checks
# whether it's actually supported by its sources. If not, ONE corrected
# revision streams in as a visible replacement (not a silent retry).
ENABLE_SELF_VERIFICATION=true

# Conversation config - how many recent messages to include as context for follow-ups
CONVERSATION_HISTORY_TURNS=6

# --- Production deployment (optional, both unset by default) ---
# Locks CORS down to one origin instead of allowing all - only relevant if
# the frontend is deployed to a separate domain from this backend. See the
# Deployment section in the root README.
ALLOWED_ORIGIN=

# --- Evaluation harness (optional, npm run eval - see README's Evaluation section) ---
# Defaults to GENERATION_MODEL if unset - grading needs a reasoning-capable
# model, not the lighter UTILITY_MODEL used for simple tasks like rewriting.
EVAL_JUDGE_MODEL=
