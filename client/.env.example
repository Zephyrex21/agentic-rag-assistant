# Optional - only needed when the frontend and backend are deployed to
# separate domains (see the Deployment section in the root README).
#
# Leave this unset for local development (Vite's dev-server proxy in
# vite.config.ts already routes /api/* to the backend on :5000) and for
# any production setup where both are served from the same origin.
#
# VITE_API_BASE_URL=https://your-backend-url.onrender.com
